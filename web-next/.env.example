# Optional TokenRouter LLM brain — parses chat -> purchase intent.
# Leave unset to use the deterministic regex fallback (demo works either way).
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.aicredits.in/v1
TOKENROUTER_MODEL=deepseek/deepseek-v4-flash

# Explorer base used for tx links rendered in the dashboard.
PHAROS_EXPLORER=https://atlantic.pharosscan.xyz/tx/
