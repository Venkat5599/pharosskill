# Copy to .env and fill in to go live on Pharos Atlantic testnet.
# Get PHRS gas:  https://testnet.pharosnetwork.xyz/  ·  https://zan.top/faucet/pharos
# Get test USDC: Pharos testnet faucet / swap (token 0xE0BE08c77f415F577A1B3A9aD7a1Df1479564ec8)

USE_PHAROS=1

# --- Cashier's LLM brain (TokenRouter, OpenAI-compatible). Optional. ---
# When set, Cashier parses chat -> purchase intent via the LLM; else regex fallback.
TOKENROUTER_API_KEY=sk-...
TOKENROUTER_MODEL=MiniMax-M3
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# Payer wallet — MUST hold test USDC (this is what safeBuy spends).
PAYER_PRIVATE_KEY=0x...

# Facilitator wallet — MUST hold PHRS gas (broadcasts settlement on-chain).
FACILITATOR_PRIVATE_KEY=0x...

# Where the provider's USDC payments go (can be any address you control).
PROVIDER_ADDRESS=0x...

# Endpoints / chain (defaults shown).
PHAROS_RPC=https://atlantic.dplabs-internal.com/
TEST_USDC=0xE0BE08c77f415F577A1B3A9aD7a1Df1479564ec8
FACILITATOR_URL=http://localhost:4022
PROVIDER_PORT=4021
PHAROS_EXPLORER=https://testnet.pharosscan.xyz/tx/
